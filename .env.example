PORT=4000
CORS_ORIGINS=http://localhost:3000
# Clave privada para las escrituras de catálogos y listados de gestión.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MANAGEMENT_API_KEY=

# Copiar los valores reales de hPanel. No versionar .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Para conexiones remotas: habilitar TLS si el servidor lo admite, o usar túnel SSH.
DB_SSL=false
# DB_SSL_CA=/ruta/al/certificado-ca.pem
